<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp" android:background="@drawable/bg_card">
<TextView android:id="@+id/rowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="17sp" android:textColor="#124559"/>
<TextView android:id="@+id/rowLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#526A75" android:layout_marginTop="5dp"/>
<TextView android:id="@+id/rowDateTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#526A75" android:layout_marginTop="3dp"/>
<TextView android:id="@+id/rowReminder" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#176B87" android:textStyle="bold" android:layout_marginTop="6dp"/>
</LinearLayout>